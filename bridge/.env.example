# Copy to /etc/siem-bridge/bridge.env on the SOC VM (root:root, mode 600)
GCP_PROJECT_ID=your-firebase-project-id
SERVICE_ACCOUNT_PATH=/etc/siem-bridge/sa.json
ALERTS_PATH=/var/ossec/logs/alerts/alerts.json
# On the SOC VM the manager bind-mounts logs at <repo>/data/ossec/logs — set e.g.:
# ALERTS_PATH=/opt/siem-bridge-repo/data/ossec/logs/alerts/alerts.json
OFFSET_PATH=/var/lib/siem-bridge/offset.json

# VirusTotal (optional; level >= 7 only, 4 req/min, 24h cache)
VT_API_KEY=
VT_MIN_LEVEL=7

# FCM push threshold
FCM_TOPIC=analysts
FCM_MIN_LEVEL=10

# Wazuh rule ids that trigger active-response docs (SSH brute force family)
RESPONSE_RULE_IDS=5710,5712

POLL_INTERVAL_MS=1000
